# Copy this file to .env and fill in real values. Never commit .env itself.
GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
HUGGINGFACE_TOKEN=your_hf_token_here
# --- AI upgrade (all optional; defaults shown) ---
AGRIVISION_MOE_ROUTING=top1        # top1 | both  (both = run all experts of the domain; measure first)
AGRIVISION_MOE_ENABLED=auto        # auto | true | false  (intra-domain moe_gate; NOT the confidence gate)
RAG_BACKEND=auto                   # auto | faiss | lexical (lexical = torch-free BM25)
# RAG_RERANK_MODEL=                # optional cross-encoder, off by default
WEATHER_ENABLED=false              # true -> Open-Meteo (free, no key) cloud-side only
ADVISORY_BACKEND=gemini            # gemini | local_llm | mock
# LOCAL_LLM_URL=http://localhost:8000/v1
# LOCAL_LLM_MODEL=agrivision-advisor
# LOCAL_LLM_API_KEY=
